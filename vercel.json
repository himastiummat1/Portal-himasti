{
    "version": 2,
    "buildCommand": "bash build-patch.sh",
    "builds": [
        {
            "src": "api/index.php",
            "use": "@beyondcode/vercel-php-82"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
