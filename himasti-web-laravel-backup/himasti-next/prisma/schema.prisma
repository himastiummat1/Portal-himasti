generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  remember_token    String?
  deleted_at        DateTime?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  data_kader        DataKader?
  meetings          Meeting[]
  keuangans         Keuangan[]
  surats            Surat[]
  absensis          Absensi[]
  event_regs        EventRegistration[]
  meeting_attendances MeetingAttendance[]

  // Spatie Roles
  roles             ModelHasRole[]

  @@map("users")
}

model DataKader {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  nim               String?   @unique
  angkatan          String?
  status_kaderisasi String
  skills            String?
  no_hp             String?
  jenis_kelamin     String?
  deleted_at        DateTime?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("data_kaders")
}

model Surat {
  id                Int       @id @default(autoincrement())
  user_id           Int?
  user              User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  nomor_surat       String?
  jenis_surat       String    // "Masuk" atau "Keluar"
  perihal           String
  tanggal_surat     DateTime  @default(now())
  pengirim          String?
  tujuan            String?
  status            String    @default("pending")
  file_path         String?
  deleted_at        DateTime?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("surats")
}

model Keuangan {
  id                Int       @id @default(autoincrement())
  user_id           Int?
  user              User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  tipe              String    // 'pemasukan', 'pengeluaran'
  nominal           Decimal   @db.Decimal(12, 2)
  keterangan        String
  tanggal           DateTime  @db.Date
  bukti_pembayaran  String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("keuangans")
}

model Meeting {
  id                Int       @id @default(autoincrement())
  title             String
  description       String
  type              String    @default("rapat_pengurus") // 'rapat_pengurus', 'rapat_panitia'
  event_date        DateTime
  location          String
  notulensi_path    String?
  
  // Geofencing & Smart Attendance
  latitude          Float?
  longitude         Float?
  radius_meter      Int?      @default(50)
  qr_secret         String?
  is_active         Boolean?  @default(true)

  created_by        Int
  creator           User      @relation(fields: [created_by], references: [id], onDelete: Cascade)
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  attendances       MeetingAttendance[]

  @@map("meetings")
}

model Artikel {
  id                Int       @id @default(autoincrement())
  title             String
  description       String
  link              String?
  status            String    @default("Draft")
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("artikels")
}

// === Spatie Permissions Mapping ===

model Role {
  id                Int       @id @default(autoincrement())
  name              String
  guard_name        String
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  users             ModelHasRole[]
  permissions       RoleHasPermission[]

  @@unique([name, guard_name])
  @@map("roles")
}

model Permission {
  id                Int       @id @default(autoincrement())
  name              String
  guard_name        String
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  roles             RoleHasPermission[]

  @@unique([name, guard_name])
  @@map("permissions")
}

model ModelHasRole {
  role_id           Int
  model_type        String
  model_id          Int

  role              Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type])
  @@map("model_has_roles")
}

model RoleHasPermission {
  permission_id     Int
  role_id           Int

  permission        Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role              Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@map("role_has_permissions")
}

// === Modul Akademik & Karya ===

model ItModule {
  id              Int       @id @default(autoincrement())
  title           String
  category        String
  description     String?
  code_snippet    String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("it_modules")
}

model StudentProject {
  id              Int       @id @default(autoincrement())
  title           String
  student_name    String
  category        String    // web, mobile, script, ui/ux
  description     String?
  screenshot      String?
  github_link     String?
  demo_link       String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("student_projects")
}

model CompetitionInfo {
  id              Int       @id @default(autoincrement())
  title           String
  type            String    // lomba, hackathon, sertifikasi
  organizer       String
  description     String?
  link            String?
  deadline        DateTime? @db.Date
  poster          String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("competition_infos")
}


// === Modul Divisi & Event ===

model Event {
  id                Int       @id @default(autoincrement())
  nama_event        String
  deskripsi         String
  tanggal_mulai     DateTime
  tanggal_selesai   DateTime
  status            String    @default("draft")
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  absensis          Absensi[]
  registrations     EventRegistration[]

  @@map("events")
}

model Absensi {
  id                Int       @id @default(autoincrement())
  event_id          Int
  event             Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id           Int
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  waktu_hadir       DateTime
  status_kehadiran  String    @default("hadir") // hadir, izin, sakit, alfa
  catatan           String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("absensis")
}

model EventRegistration {
  id                Int       @id @default(autoincrement())
  event_id          Int
  event             Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id           Int
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status_pendaftaran String   @default("pending") // pending, approved, rejected
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("event_registrations")
}

model Survey {
  id                Int       @id @default(autoincrement())
  status            String    @default("draft")
  title             String
  description       String
  link              String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("surveys")
}

model Klub {
  id                Int       @id @default(autoincrement())
  title             String
  description       String
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("klubs")
}

model Merchandise {
  id                Int       @id @default(autoincrement())
  title             String
  description       String
  gambar            String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@map("merchandises")
}

model MeetingAttendance {
  id                Int       @id @default(autoincrement())
  meeting_id        Int
  meeting           Meeting   @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  user_id           Int
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  waktu_hadir       DateTime  @default(now())
  status_kehadiran  String    @default("hadir")
  latitude_scan     Float?
  longitude_scan    Float?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@unique([meeting_id, user_id])
  @@map("meeting_attendances")
}
