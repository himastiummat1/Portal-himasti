/// WebAuthn / Passkeys hardware-grade physical credentials for zero-joki attendance
model webauthn_credentials {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  credential_id String    @unique @db.VarChar(512)
  public_key    String    @db.Text
  counter       BigInt    @default(0)
  device_type   String?   @db.VarChar(50)
  backed_up     Boolean   @default(false)
  transports    String?   @db.VarChar(255)
  device_name   String?   @db.VarChar(255)
  aaguid        String?   @db.VarChar(64)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  last_used_at  DateTime? @db.Timestamp(0)

  @@index([user_id], map: "webauthn_credentials_user_id_index")
}

